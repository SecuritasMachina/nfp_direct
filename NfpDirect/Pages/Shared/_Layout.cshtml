<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | NFP Direct</title>
    @if (ViewData["Description"] is string desc)
    {
        <meta name="description" content="@desc" />
    }
    @{
        var canonicalUrl = ViewData["CanonicalUrl"] as string
            ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    }
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:site_name" content="NFP Direct" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@ViewData["Title"] | NFP Direct" />
    @if (ViewData["Description"] is string ogDesc)
    {
        <meta property="og:description" content="@ogDesc" />
    }

    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    @if (ViewData["GeoRegion"] is string geoRegion)
    {
        <meta name="geo.region" content="@geoRegion" />
        @if (ViewData["GeoPlacename"] is string geoPlacename)
        {
            <meta name="geo.placename" content="@geoPlacename" />
        }
    }
    <link rel="search" type="application/opensearchdescription+xml" title="NFP Direct" href="/opensearch.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha384-/o6I2CkkWC//PSjvWC/eYN7l3xM3tJm8ZzVkCOfp//W05QcE3mlGskpoHB6XqI+B"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    @RenderSection("Head", required: false)
    <meta name="theme-color" content="#0d6efd" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">NFP Direct</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link@(Context.Request.Path == "/" ? " active" : "")"
                           @(Context.Request.Path == "/" ? "aria-current=\"page\"" : "")
                           href="/">Browse</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(Context.Request.Path.StartsWithSegments("/ByPostcard") ? " active" : "")"
                           @(Context.Request.Path.StartsWithSegments("/ByPostcard") ? "aria-current=\"page\"" : "")
                           href="/ByPostcard">By Postcard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(Context.Request.Path.StartsWithSegments("/Search") ? " active" : "")"
                           @(Context.Request.Path.StartsWithSegments("/Search") ? "aria-current=\"page\"" : "")
                           href="/Search">Search</a>
                    </li>
                </ul>
                <form class="d-flex ms-auto" method="get" action="/Search" role="search">
                    <div class="input-group input-group-sm">
                        <input class="form-control" type="search" name="q"
                               placeholder="Search org name or EIN…"
                               aria-label="Search organizations"
                               accesskey="s"
                               value="@(ViewData["SearchQuery"] as string ?? "")" />
                        <button class="btn btn-light" type="submit" aria-label="Search">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </nav>

    <datalist id="us-states">
        @foreach (var kv in TypeCodeHelper.UsStates.OrderBy(kv => kv.Value))
        {
            <option value="@kv.Key">@kv.Value</option>
        }
    </datalist>

    <main id="main-content" class="container-fluid px-4">
        @RenderBody()
    </main>

    <footer class="footer mt-4 py-3 bg-light">
        <div class="container text-center">
            <a href="https://ackdev.com" target="_blank" rel="noopener noreferrer" class="text-muted">
                Free Non-Profit Lookup Service by AckDev Inc.
            </a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmB+JpGDN9lFpbFGzJnr+IKzmOb"
            crossorigin="anonymous"></script>
</body>
</html>
