@page
@model DetailsModel
@{
    var name = Model.Pub78 != null
        ? TypeCodeHelper.TitleCase(Model.Pub78.CompanyName ?? Model.Id)
        : Model.Id;
    ViewData["Title"] = name;
    ViewData["Description"] = Model.Pub78 != null
        ? $"Non-profit organization details for {name} (EIN {Model.Id})."
        : $"EIN {Model.Id} not found.";
}


<div class="mb-2">
    <a href="@Model.BackUrl" class="btn btn-sm btn-outline-secondary">← Back</a>
</div>

@if (Model.Pub78 == null)
{
    <div class="alert alert-warning">
        Organization with EIN <strong>@Model.Id</strong> not found.
    </div>
}
else
{
    var pub = Model.Pub78;
    <div class="card mb-3">
        <div class="card-body">
            <h4 class="card-title">
                @name
                <small class="text-muted">EIN: @TypeCodeHelper.FormatEin(Model.Id)</small>
                @if (pub.TypeCode != null)
                {
                    <span class="badge bg-secondary ms-2" title="IRC 501(c)(@pub.TypeCode)">@TypeCodeHelper.Label(pub.TypeCode)</span>
                }
                <a class="btn btn-sm btn-outline-primary ms-2" target="_blank"
                   href="https://news.google.com/search?q=@Uri.EscapeDataString((pub.CompanyName ?? name) + " " + (pub.City ?? ""))">
                    <i class="fab fa-google" aria-hidden="true"></i> News
                </a>
                @if (Model.Filing != null)
                {
                    <a class="btn btn-sm btn-outline-secondary ms-1" href="#filing">Filing ↓</a>
                }
            </h4>

            @if (Model.Postcard != null)
            {
                var pc = Model.Postcard;
                <h6 class="text-muted">Year: @pc.Year</h6>

                <address>
                    @pc.OrgAddressLine1<br />
                    @if (!string.IsNullOrWhiteSpace(pc.OrgAddressLine2))
                    {
                        @pc.OrgAddressLine2<br />
                    }
                    @pc.OrgCity, @pc.OrgState @pc.OrgPostalCode<br />
                    @pc.OrgCountry
                </address>

                @if (!string.IsNullOrWhiteSpace(pc.DBA1))
                {
                    <h6>Doing Business As:</h6>
                    <p>
                        @TypeCodeHelper.TitleCase(pc.DBA1)
                        <a class="btn btn-sm btn-outline-primary ms-1" target="_blank"
                           href="https://news.google.com/search?q=@Uri.EscapeDataString(pc.DBA1 ?? "")">DBA News</a><br />
                        @if (!string.IsNullOrWhiteSpace(pc.DBA2)) { @TypeCodeHelper.TitleCase(pc.DBA2)<br /> }
                        @if (!string.IsNullOrWhiteSpace(pc.DBA3)) { @TypeCodeHelper.TitleCase(pc.DBA3)<br /> }
                    </p>
                }

                <h6>Officer Information:</h6>
                <address>
                    <a target="_blank"
                       href="https://www.google.com/search?q=@Uri.EscapeDataString((pc.OfficerName ?? "") + " " + pc.OfficerAddressCity)">
                        @TypeCodeHelper.TitleCase(pc.OfficerName)
                    </a>
                    <a class="btn btn-sm btn-outline-primary ms-1" target="_blank"
                       href="https://news.google.com/search?q=@Uri.EscapeDataString((pc.OfficerName ?? "") + " " + pc.OfficerAddressCity)">
                        News
                    </a><br />
                    @pc.OfficerAddressLine1<br />
                    @if (!string.IsNullOrWhiteSpace(pc.OfficerAddressLine2))
                    {
                        @pc.OfficerAddressLine2<br />
                    }
                    @pc.OfficerAddressCity@(pc.State != null ? ", " + pc.State : "") @pc.PostalCode<br />
                    @pc.Country
                </address>

                <p class="mb-2">
                    <strong>Gross Receipts Under $25K:</strong> @TypeCodeHelper.YesNo(pc.GrossReceiptsUnder25k)<br />
                    <strong>Terminated:</strong> @TypeCodeHelper.YesNo(pc.Terminated)
                </p>

                <div class="mt-2">
                    @if (!string.IsNullOrWhiteSpace(pc.WebsiteURL) &&
                         !pc.WebsiteURL.Equals("n/a", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="btn btn-outline-primary me-2" target="_blank" href="@(pc.WebsiteURL!.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? pc.WebsiteURL : "http://" + pc.WebsiteURL)">
                            <i class="fa fa-globe" aria-hidden="true"></i> Website (@pc.WebsiteURL)
                        </a>
                    }
                    else
                    {
                        <span class="text-muted me-2">No website found.</span>
                        <a class="btn btn-outline-secondary me-2" target="_blank"
                           href="https://www.google.com/search?q=@Uri.EscapeDataString(pc.CompanyName ?? "")">
                            <i class="fab fa-google" aria-hidden="true"></i> Try Google
                        </a>
                    }
                    <a class="btn btn-outline-primary" target="_blank"
                       href="https://www.google.com/search?q=@Uri.EscapeDataString(pc.CompanyName ?? "")">
                        <i class="fab fa-google" aria-hidden="true"></i> Google @pc.CompanyName
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted mb-1">No postcard information found for this organization.</p>
                @if (pub.City != null || pub.State != null || pub.Country != null)
                {
                    <address class="small text-muted">
                        @pub.City@(pub.State != null ? ", " + pub.State : "")
                        @pub.Country
                    </address>
                }
            }
        </div>
    </div>

    @if (Model.Filing != null)
    {
        var f = Model.Filing;
        <div class="card mb-3" id="filing">
            <div class="card-header bg-primary text-white">Filing Details</div>
            <div class="card-body small">

                <p class="text-muted small text-uppercase fw-semibold mb-1">Identity</p>
                <dl class="row mb-3">
                    <dt class="col-sm-6">EIN</dt><dd class="col-sm-6">@TypeCodeHelper.FormatEin(f.EIN)</dd>
                    <dt class="col-sm-6">Tax period</dt><dd class="col-sm-6">@TypeCodeHelper.FormatTaxPeriod(f.TaxPd)</dd>
                    <dt class="col-sm-6">Subsection code</dt><dd class="col-sm-6">@TypeCodeHelper.Fmt(f.Subseccd)</dd>
                    <dt class="col-sm-6">Described in 501(c)(3)?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.S501c3or4947a1cd)</dd>
                    <dt class="col-sm-6">Terminated?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Ceaseoperationscd)</dd>
                </dl>

                <p class="text-muted small text-uppercase fw-semibold mb-1">Governance &amp; Activities</p>
                <dl class="row mb-3">
                    <dt class="col-sm-6">Schedule B required?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Schdbind)</dd>
                    <dt class="col-sm-6">Political activities?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Politicalactvtscd)</dd>
                    <dt class="col-sm-6">Lobbying activities?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Lbbyingactvtscd)</dd>
                    <dt class="col-sm-6">Subject to proxy tax?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Subjto6033cd)</dd>
                    <dt class="col-sm-6">Donor advised funds?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Dnradvisedfundscd)</dd>
                    <dt class="col-sm-6">Conservation easements?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Prptyintrcvdcd)</dd>
                    <dt class="col-sm-6">Collections of art?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Maintwrkofartcd)</dd>
                    <dt class="col-sm-6">Credit counseling?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Crcounselingqstncd)</dd>
                    <dt class="col-sm-6">Term or permanent endowments?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Hldassetsintermpermcd)</dd>
                    <dt class="col-sm-6">Hospital?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Operatehosptlcd)</dd>
                    <dt class="col-sm-6">School?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Operateschools170cd)</dd>
                    <dt class="col-sm-6">Foreign office?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Frgnofficecd)</dd>
                    <dt class="col-sm-6">Unrelated business income?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Unrelbusinccd)</dd>
                    <dt class="col-sm-6">Foreign financial account?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Frgnacctcd)</dd>
                    <dt class="col-sm-6">Excess benefit transaction?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Engageexcessbnftcd)</dd>
                    <dt class="col-sm-6">Loan to officer or DQP?</dt><dd class="col-sm-6">@TypeCodeHelper.YesNo(f.Loantofficercd)</dd>
                </dl>

                <p class="text-muted small text-uppercase fw-semibold mb-1">Financial Summary</p>
                <dl class="row mb-3">
                    <dt class="col-sm-6">Number of employees</dt><dd class="col-sm-6">@TypeCodeHelper.Fmt(f.Noemplyeesw3cnt)</dd>
                    <dt class="col-sm-6">Total contributions</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totcntrbgfts)</dd>
                    <dt class="col-sm-6">Program service revenue</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totprgmrevnue)</dd>
                    <dt class="col-sm-6">Total revenue</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totrevenue)</dd>
                    <dt class="col-sm-6">Total functional expenses</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totfuncexpns)</dd>
                    <dt class="col-sm-6">Total assets (eoy)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totassetsend)</dd>
                    <dt class="col-sm-6">Total liabilities (eoy)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totliabend)</dd>
                    <dt class="col-sm-6">Total net assets (eoy)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totnetassetend)</dd>
                    <dt class="col-sm-6">Gross receipts (public use)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Grsrcptspublicuse)</dd>
                </dl>

                <p class="text-muted small text-uppercase fw-semibold mb-1">Other Income</p>
                <dl class="row mb-3">
                    <dt class="col-sm-6">Investment income</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Invstmntinc)</dd>
                    <dt class="col-sm-6">Net rental income</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Netrntlinc)</dd>
                    <dt class="col-sm-6">Fundraising income</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Netincfndrsng)</dd>
                    <dt class="col-sm-6">Gaming income</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Netincgaming)</dd>
                    <dt class="col-sm-6">Sales of assets</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Netgnls)</dd>
                </dl>

                <p class="text-muted small text-uppercase fw-semibold mb-1">Expenses &amp; Grants</p>
                <dl class="row mb-3">
                    <dt class="col-sm-6">Compensation — current officers</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Compnsatncurrofcr)</dd>
                    <dt class="col-sm-6">Other salaries and wages</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Othrsalwages)</dd>
                    <dt class="col-sm-6">Professional fundraising fees</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Profndraising)</dd>
                    <dt class="col-sm-6">Grants to orgs/govts (US)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Grntstogovt)</dd>
                    <dt class="col-sm-6">Grants to individuals (US)</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Grnsttoindiv)</dd>
                    <dt class="col-sm-6">Grants to foreign orgs/govts</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Grntstofrgngovt)</dd>
                    <dt class="col-sm-6">Occupancy</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Occupancy)</dd>
                    <dt class="col-sm-6">Travel</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Travel)</dd>
                    <dt class="col-sm-6">Insurance</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Insurance)</dd>
                    <dt class="col-sm-6">Interest expense</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Interestamt)</dd>
                    <dt class="col-sm-6">Depreciation / depletion</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Deprcatndepletn)</dd>
                </dl>

                <p class="text-muted small text-uppercase fw-semibold mb-1">Compensation Disclosure</p>
                <dl class="row mb-0">
                    <dt class="col-sm-6">Reportable compensation from org</dt><dd class="col-sm-6">@TypeCodeHelper.FormatMoney(f.Totreprtabled)</dd>
                    <dt class="col-sm-6">Individuals &gt; $100K</dt><dd class="col-sm-6">@TypeCodeHelper.Fmt(f.Noindiv100kcnt)</dd>
                    <dt class="col-sm-6">Contractors &gt; $100K</dt><dd class="col-sm-6">@TypeCodeHelper.Fmt(f.Nocontractor100kcnt)</dd>
                </dl>

            </div>
        </div>
    }
}
