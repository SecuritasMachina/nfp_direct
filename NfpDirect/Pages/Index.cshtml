@page
@model IndexModel
@{
    var indexStateName = Model.StateFilter.Length > 0
        ? TypeCodeHelper.StateName(Model.StateFilter)
        : null;
    ViewData["Title"] = indexStateName != null
        ? $"Browse Non-Profits in {indexStateName} — Page {Model.PageNumber + 1}"
        : $"Browse Non-Profits — Page {Model.PageNumber + 1}";
    ViewData["Description"] = indexStateName != null
        ? $"Browse IRS-registered non-profit organizations in {indexStateName}. Filter by state, search by name or 9-digit EIN."
        : "Browse IRS-registered non-profit organizations by name. Search by organization name, 9-digit EIN, or filter by state.";
    var indexBackUrl = Uri.EscapeDataString("/" + (ViewContext.HttpContext.Request.QueryString.Value ?? ""));
    var stateQs = Model.StateFilter.Length > 0 ? $"&state={Uri.EscapeDataString(Model.StateFilter)}" : "";
    var req = ViewContext.HttpContext.Request;
    var indexPageQs = Model.PageNumber > 0 ? $"?page={Model.PageNumber}{stateQs}"
        : Model.StateFilter.Length > 0 ? $"?{stateQs[1..]}"
        : "";
    ViewData["CanonicalUrl"] = $"{req.Scheme}://{req.Host}/{indexPageQs}";
    ViewData["Robots"] = Model.PageNumber > 0
        ? "noindex, follow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";
}

@section Head {
    @if (Model.PageNumber > 0)
    {
        <link rel="prev" href="/?page=@(Model.PageNumber - 1)@stateQs" />
    }
    @if (Model.HasNextPage)
    {
        <link rel="next" href="/?page=@(Model.PageNumber + 1)@stateQs" />
    }
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 mb-0">
        Non-Profit Organizations@(indexStateName != null ? $" in {indexStateName}" : "") — Page @(Model.PageNumber + 1) of @Model.TotalPages.ToString("N0")
        <small class="text-muted fw-normal ms-2 fs-6">@Model.TotalCount.ToString("N0") total</small>
    </h1>
    <div>
        @if (Model.PageNumber > 0)
        {
            <a class="btn btn-outline-primary me-1" href="/?page=@(Model.PageNumber - 1)@stateQs">
                <i class="fa fa-chevron-left" aria-hidden="true"></i> Previous
            </a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber + 1)@stateQs">
                Next <i class="fa fa-chevron-right" aria-hidden="true"></i>
            </a>
        }
    </div>
</div>

<form method="get" action="/" class="mb-3">
    <div class="input-group input-group-sm state-filter-group">
        <input type="search" name="state" class="form-control" placeholder="Filter by state (e.g. IL)"
               maxlength="2" value="@Model.StateFilter" aria-label="Filter by state"
               list="us-states" autocomplete="off" />
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
        @if (Model.StateFilter.Length > 0)
        {
            <a class="btn btn-outline-secondary" href="/">Clear</a>
        }
    </div>
</form>

@if (!Model.Entries.Any())
{
    <div class="alert alert-info">
        @if (Model.StateFilter.Length > 0)
        {
            <text>No organizations found in state <strong>@Model.StateFilter</strong>.
            <a href="/">Clear filter</a> to browse all states.</text>
        }
        else
        {
            <text>No organizations found. The database may still be loading.</text>
        }
    </div>
}
@foreach (var entry in Model.Entries)
{
    <div class="card mb-2">
        <div class="card-body py-2">
            <h2 class="h5 card-title mb-1">
                <a href="/Details?id=@Uri.EscapeDataString(entry.Pub78.EIN)&back=@indexBackUrl" class="text-decoration-none">
                    @TypeCodeHelper.TitleCase(entry.Pub78.CompanyName)
                </a>
                <small class="text-muted ms-2">EIN: @TypeCodeHelper.FormatEin(entry.Pub78.EIN)</small>
            </h2>
            <div class="text-muted small">
                @TypeCodeHelper.FormatLocation(entry.Pub78.City, entry.Pub78.State)
                @if (TypeCodeHelper.ShouldShowCountry(entry.Pub78.Country)) { <text>· @entry.Pub78.Country</text> }
                @if (entry.Pub78.TypeCode != null)
                {
                    <span class="badge bg-secondary ms-1" title="IRC 501(c)(@entry.Pub78.TypeCode)">@TypeCodeHelper.Label(entry.Pub78.TypeCode)</span>
                }
                @if (TypeCodeHelper.YesNo(entry.Postcard?.Terminated) == "Yes")
                {
                    <span class="badge bg-danger ms-1">Terminated</span>
                }
            </div>
            @if (entry.Postcard != null)
            {
                var pc = entry.Postcard;
                <div class="mt-1">
                    @if (!string.IsNullOrWhiteSpace(pc.DBA1))
                    {
                        <span class="text-muted small">DBA: @TypeCodeHelper.TitleCase(pc.DBA1)</span>
                    }
                    <address class="mb-1 small">
                        @if (!string.IsNullOrWhiteSpace(pc.OrgAddressLine1)) { @pc.OrgAddressLine1<br /> }
                        @if (!string.IsNullOrWhiteSpace(pc.OrgAddressLine2))
                        {
                            @pc.OrgAddressLine2<br />
                        }
                        @TypeCodeHelper.FormatPostalLine(pc.OrgCity, pc.OrgState, pc.OrgPostalCode)<br />
                        @if (TypeCodeHelper.ShouldShowCountry(pc.OrgCountry)) { @pc.OrgCountry<br /> }
                    </address>
                    @{var siteUrl = TypeCodeHelper.NormalizeUrl(pc.WebsiteURL);}
                    @if (siteUrl != null)
                    {
                        <a class="btn btn-sm btn-outline-primary me-1" target="_blank" rel="noopener noreferrer"
                           href="@siteUrl">
                            <i class="fa fa-globe" aria-hidden="true"></i> @TypeCodeHelper.UrlDisplayText(siteUrl)
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary me-1" target="_blank" rel="noopener noreferrer"
                           href="https://www.google.com/search?q=@Uri.EscapeDataString(pc.CompanyName ?? entry.Pub78.CompanyName ?? "")">
                            <i class="fab fa-google" aria-hidden="true"></i> Search Google
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<nav aria-label="Page navigation" class="d-flex justify-content-between mt-3 mb-4">
    @if (Model.PageNumber > 0)
    {
        <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber - 1)@stateQs">
            <i class="fa fa-chevron-left" aria-hidden="true"></i> Previous
        </a>
    }
    else
    {
        <span></span>
    }
    @if (Model.HasNextPage)
    {
        <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber + 1)@stateQs">
            Next <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
    }
    else
    {
        <span></span>
    }
</nav>
