@page
@model IndexModel
@{
    var indexStateName = Model.StateFilter.Length > 0
        ? TypeCodeHelper.StateName(Model.StateFilter)
        : null;
    ViewData["Description"] = indexStateName != null
        ? $"Browse IRS-registered non-profit organizations in {indexStateName}. Filter by state, search by name or 9-digit EIN."
        : "Browse IRS-registered non-profit organizations by name. Search by organization name, 9-digit EIN, or filter by state.";
    var indexTypeLabel = Model.TypeFilter.Length > 0 ? TypeCodeHelper.Label(Model.TypeFilter) : null;
    if (indexStateName != null && indexTypeLabel != null)
        ViewData["Title"] = $"Browse {indexTypeLabel} in {indexStateName} — Page {Model.PageNumber + 1}";
    else if (indexTypeLabel != null)
        ViewData["Title"] = $"Browse {indexTypeLabel} Organizations — Page {Model.PageNumber + 1}";
    else if (indexStateName != null)
        ViewData["Title"] = $"Browse Non-Profits in {indexStateName} — Page {Model.PageNumber + 1}";
    else
        ViewData["Title"] = $"Browse Non-Profits — Page {Model.PageNumber + 1}";
    var indexBackUrl = Uri.EscapeDataString("/" + (ViewContext.HttpContext.Request.QueryString.Value ?? ""));
    var stateQs = Model.StateFilter.Length > 0 ? $"&state={Uri.EscapeDataString(Model.StateFilter)}" : "";
    var typeQs = Model.TypeFilter.Length > 0 ? $"&type={Uri.EscapeDataString(Model.TypeFilter)}" : "";
    var req = ViewContext.HttpContext.Request;
    var indexPageQs = Model.PageNumber > 0 ? $"?page={Model.PageNumber}{stateQs}{typeQs}"
        : (Model.StateFilter.Length > 0 || Model.TypeFilter.Length > 0) ? $"?{(stateQs + typeQs).TrimStart('&')}"
        : "";
    ViewData["CanonicalUrl"] = $"{req.Scheme}://{req.Host}/{indexPageQs}";
    ViewData["Robots"] = Model.PageNumber > 0
        ? "noindex, follow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";
    if (indexStateName != null)
    {
        ViewData["GeoRegion"] = $"US-{Model.StateFilter}";
        ViewData["GeoPlacename"] = indexStateName;
    }
}

@section Head {
    @if (Model.PageNumber > 0)
    {
        <link rel="prev" href="/?page=@(Model.PageNumber - 1)@stateQs@typeQs" />
    }
    @if (Model.HasNextPage)
    {
        <link rel="next" href="/?page=@(Model.PageNumber + 1)@stateQs@typeQs" />
    }
    @if (Model.PageNumber == 0 && Model.StateFilter.Length == 0)
    {
        var wsNonce = ViewContext.HttpContext.Items["csp-nonce"] as string ?? "";
        var wsOrigin = $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}";
        var wsLd = new System.Collections.Generic.Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = "NFP Direct",
            ["url"] = wsOrigin + "/",
            ["description"] = "Free IRS non-profit organization lookup — search by name or EIN, browse by state.",
            ["potentialAction"] = new System.Collections.Generic.Dictionary<string, object>
            {
                ["@type"] = "SearchAction",
                ["target"] = new System.Collections.Generic.Dictionary<string, object>
                {
                    ["@type"] = "EntryPoint",
                    ["urlTemplate"] = wsOrigin + "/Search?q={search_term_string}"
                },
                ["query-input"] = "required name=search_term_string"
            }
        };
        var wsJson = System.Text.Json.JsonSerializer.Serialize(wsLd);
        <script type="application/ld+json" nonce="@wsNonce">@Html.Raw(wsJson)</script>
    }
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 mb-0">
        @(indexTypeLabel != null ? indexTypeLabel + " Organizations" : "Non-Profit Organizations")@(indexStateName != null ? $" in {indexStateName}" : "") — Page @(Model.PageNumber + 1) of @Model.TotalPages.ToString("N0")
        <small class="text-muted fw-normal ms-2 fs-6">@Model.TotalCount.ToString("N0") total</small>
    </h1>
    <div>
        @if (Model.PageNumber > 0)
        {
            <a class="btn btn-outline-primary me-1" href="/?page=@(Model.PageNumber - 1)@stateQs">
                <i class="fa fa-chevron-left" aria-hidden="true"></i> Previous
            </a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber + 1)@stateQs">
                Next <i class="fa fa-chevron-right" aria-hidden="true"></i>
            </a>
        }
    </div>
</div>

<form method="get" action="/" class="mb-3">
    <div class="input-group input-group-sm state-filter-group">
        <input type="search" name="state" class="form-control" placeholder="Filter by state (e.g. IL)"
               maxlength="2" value="@Model.StateFilter" aria-label="Filter by state"
               list="us-states" autocomplete="off" />
        <select name="type" class="form-select form-select-sm" aria-label="Filter by type" style="max-width:180px">
            <option value="">All Types</option>
            @foreach (var kv in NfpDirect.Helpers.TypeCodeHelper.Labels.OrderBy(x => x.Value))
            {
                if (Model.TypeFilter == kv.Key)
                {
                    <option value="@kv.Key" selected>@kv.Value</option>
                }
                else
                {
                    <option value="@kv.Key">@kv.Value</option>
                }
            }
        </select>
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
        @if (Model.StateFilter.Length > 0 || Model.TypeFilter.Length > 0)
        {
            <a class="btn btn-outline-secondary" href="/">Clear</a>
        }
    </div>
</form>

@if (!Model.Entries.Any())
{
    <div class="alert alert-info">
        @if (Model.StateFilter.Length > 0)
        {
            <text>No organizations found in state <strong>@Model.StateFilter</strong>.
            <a href="/">Clear filter</a> to browse all states.</text>
        }
        else
        {
            <text>No organizations found. The database may still be loading.</text>
        }
    </div>
}
@foreach (var entry in Model.Entries)
{
    <div class="card mb-2">
        <div class="card-body py-2">
            <h2 class="h5 card-title mb-1">
                <a href="/Details?id=@Uri.EscapeDataString(entry.Pub78.EIN)&back=@indexBackUrl" class="text-decoration-none">
                    @TypeCodeHelper.TitleCase(entry.Pub78.CompanyName)
                </a>
                <small class="text-muted ms-2">EIN: @TypeCodeHelper.FormatEin(entry.Pub78.EIN)</small>
            </h2>
            <div class="text-muted small">
                @TypeCodeHelper.FormatLocation(entry.Pub78.City, entry.Pub78.State)
                @if (TypeCodeHelper.ShouldShowCountry(entry.Pub78.Country)) { <text>· @entry.Pub78.Country</text> }
                @if (entry.Pub78.TypeCode != null)
                {
                    <span class="badge bg-secondary ms-1" title="IRC 501(c)(@entry.Pub78.TypeCode)">@TypeCodeHelper.Label(entry.Pub78.TypeCode)</span>
                }
                @if (TypeCodeHelper.YesNo(entry.Postcard?.Terminated) == "Yes")
                {
                    <span class="badge bg-danger ms-1">Terminated</span>
                }
            </div>
            @if (entry.Postcard != null)
            {
                var pc = entry.Postcard;
                <div class="mt-1">
                    @if (!string.IsNullOrWhiteSpace(pc.DBA1))
                    {
                        <span class="text-muted small">DBA: @TypeCodeHelper.TitleCase(pc.DBA1)</span>
                    }
                    <address class="mb-1 small">
                        @if (!string.IsNullOrWhiteSpace(pc.OrgAddressLine1)) { @pc.OrgAddressLine1<br /> }
                        @if (!string.IsNullOrWhiteSpace(pc.OrgAddressLine2))
                        {
                            @pc.OrgAddressLine2<br />
                        }
                        @TypeCodeHelper.FormatPostalLine(pc.OrgCity, pc.OrgState, pc.OrgPostalCode)<br />
                        @if (TypeCodeHelper.ShouldShowCountry(pc.OrgCountry)) { @pc.OrgCountry<br /> }
                    </address>
                    @{var siteUrl = TypeCodeHelper.NormalizeUrl(pc.WebsiteURL);}
                    @if (siteUrl != null)
                    {
                        <a class="btn btn-sm btn-outline-primary me-1" target="_blank" rel="noopener noreferrer"
                           href="@siteUrl">
                            <i class="fa fa-globe" aria-hidden="true"></i> @TypeCodeHelper.UrlDisplayText(siteUrl)
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary me-1" target="_blank" rel="noopener noreferrer"
                           href="https://www.google.com/search?q=@Uri.EscapeDataString(pc.CompanyName ?? entry.Pub78.CompanyName ?? "")">
                            <i class="fab fa-google" aria-hidden="true"></i> Search Google
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<nav aria-label="Page navigation" class="d-flex justify-content-between mt-3 mb-4">
    @if (Model.PageNumber > 0)
    {
        <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber - 1)@stateQs@typeQs">
            <i class="fa fa-chevron-left" aria-hidden="true"></i> Previous
        </a>
    }
    else
    {
        <span></span>
    }
    @if (Model.HasNextPage)
    {
        <a class="btn btn-outline-primary" href="/?page=@(Model.PageNumber + 1)@stateQs@typeQs">
            Next <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
    }
    else
    {
        <span></span>
    }
</nav>

@if (Model.PageNumber == 0 && Model.StateFilter.Length == 0 && Model.TypeFilter.Length == 0)
{
    <section aria-label="Browse by state" class="mt-4">
        <h2 class="h6 text-muted text-uppercase mb-2">Browse by State</h2>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var kv in TypeCodeHelper.UsStates.OrderBy(s => s.Value))
            {
                <a class="btn btn-sm btn-outline-secondary" href="/?state=@Uri.EscapeDataString(kv.Key)">
                    @kv.Key <span class="text-muted">@kv.Value</span>
                </a>
            }
        </div>
    </section>
    <section aria-label="Browse by type" class="mt-3">
        <h2 class="h6 text-muted text-uppercase mb-2">Browse by Type</h2>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var kv in NfpDirect.Helpers.TypeCodeHelper.Labels.OrderBy(x => x.Value))
            {
                <a class="btn btn-sm btn-outline-secondary" href="/?type=@Uri.EscapeDataString(kv.Key)">
                    @kv.Value
                </a>
            }
        </div>
    </section>
}
