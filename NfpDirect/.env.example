# Copy to .env and fill in real values before running docker-compose.beta.yml
# Usage: docker compose -f docker-compose.beta.yml --env-file .env up -d

# MariaDB credentials (shared between the DB container and the app connection string)
NFP_DB_PASSWORD=change_me_strong_password
NFP_DB_ROOT_PASSWORD=change_me_root_password

# Host port to expose the web app on (default: 8096)
NFP_BETA_PORT=8096
